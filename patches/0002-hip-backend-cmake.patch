+            else()
+                add_compile_options("$<$<COMPILE_LANGUAGE:HIP>:-include${ALICEVISION_HIP_DIR}/cheshire/cuda_to_hip.h>")
+            endif()
+            add_compile_options("$<$<COMPILE_LANGUAGE:HIP>:-Wno-ignored-attributes>" "$<$<COMPILE_LANGUAGE:HIP>:-Wno-unknown-attributes>")
+            if (WIN32)
